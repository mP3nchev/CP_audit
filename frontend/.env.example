# Backend API URL (server-side only, used by Next.js API routes)
BACKEND_API_URL=https://your-backend.railway.app

# Internal API Key for authenticating with backend (server-side only)
# IMPORTANT: This should match the INTERNAL_API_KEY in your backend
# DO NOT use NEXT_PUBLIC_ prefix - this must stay server-side!
INTERNAL_API_KEY=your-64-character-hex-key-here

# NOTE: We do NOT use NEXT_PUBLIC_* env vars for API keys anymore.
# API keys are injected server-side via /api/proxy route for security.

# Server Configuration
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=./audits.db

# Claude API
CLAUDE_API_KEY=sk-ant-api03-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# Budget Control (In-Memory - resets on server restart)
DAILY_BUDGET_USD=10.0

# Vercel Blob Storage
VERCEL_BLOB_TOKEN=vercel_blob_xxxxx

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=10

# Puppeteer Configuration
PUPPETEER_TIMEOUT_MS=120000
PUPPETEER_HEADLESS=true

# Screenshot Configuration (Feature Flag)
ENABLE_SCREENSHOTS=false
SCREENSHOT_TIMEOUT_MS=20000

# Consent Simulation (Workaround for local testing)
SKIP_CONSENT_CHECK=false

# Auth
INTERNAL_API_KEY=gdpr-audit-internal-key-change-in-production

# CORS
CORS_ALLOWED_ORIGINS=https://cp-audit-dg6j.vercel.app

# Blob Security
BLOB_SIGNING_SECRET=generate-with-openssl-rand-hex-32
BLOB_RETENTION_DAYS=90

# Backup
BACKUP_DIR=/app/backups
MAX_BACKUPS=30

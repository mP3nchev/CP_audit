8303de7209a091731439a01_Startup%20%26%20Tech%20asset.webp\" width=\"256\" alt=\"Startup &amp; Tech Asset\" style=\"opacity:0\" sizes=\"(max-width: 479px) 100vw, 256px\" data-w-id=\"d470ebaf-8ab6-2407-f9c3-27d1563e9c7a\" loading=\"lazy\" srcset=\"https://cdn.prod.website-files.com/682f5a25d5391b32b471c91f/68303de7209a091731439a01_Startup%20%26%20Tech%20asset.webp 500w, https://cdn.prod.website-files.com/682f5a25d5391b32b471c91f/68303de7209a091731439a01_Startup%20%26%20Tech%20asset.webp 512w\"/></div><div class=\"is-bigger-crumb hide-tablet\"></div><div class=\"is-bigger-crumb-2\"></div><div class=\"is-biggest-crumb\"></div><div class=\"is-small-crumb\"></div><div class=\"is-small-crumb is-different-position\"></div></div></div></div></div></div><div id=\"contacts\" class=\"footer_section\"><div class=\"padding-global\"><div class=\"container-large\"><div class=\"all-footer-info-wrapper\"><div class=\"footer-info_wrapper\"><div class=\"location-logo-wrapper\"><a aria-label=\"home-link\" href=\"#\" class=\"footer-logo-link w-inline-block\"><img src=\"https://cdn.prod.website-files.com/682f5a25d5391b32b471c91f/68303de7209a0917314399c5_Craft%20Policy%20Logo.svg\" loading=\"lazy\" alt=\"Craft Policy Logo\" class=\"footer-logo\"/></a><div class=\"contact-footer\"><div class=\"icon-info_wrapper\"><div class=\"is-info-icon w-embed\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"21\" height=\"21\" viewBox=\"0 0 21 21\" fill=\"none\" preserveAspectRatio=\"xMidYMid meet\" aria-hidden=\"true\" role=\"img\">\n<path d=\"M8.91284 9.44141C8.91284 6.95612 6.67427 4.94141 3.91284 4.94141L3.91284 13.9414C6.67427 13.9414 8.91284 11.9267 8.91284 9.44141Z\" fill=\"#0075FF\"/>\n<path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M3.71284 3.74121H18.1128C19.1028 3.74121 19.9128 4.55121 19.9128 5.54121V16.3412C19.9128 17.3312 19.1028 18.1412 18.1128 18.1412H3.71284C2.72284 18.1412 1.91284 17.3312 1.91284 16.3412V5.54121C1.91284 4.55121 2.72284 3.74121 3.71284 3.74121Z\" stroke=\"#CCCCCC\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n<path d=\"M18.9128 3.94141L10.9128 11.9414L2.91284 3.94141\" stroke=\"#CCCCCC\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n</svg></div><a aria-label=\"email-link\" href=\"mailto:martin@craftpolicy.com\" class=\"footer_link w-inline-block\"><div>martin@craftpolicy.com</div></a></div><div class=\"icon-info_wrapper\"><div class=\"is-info-icon w-embed\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 21 21\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M14.958 9.76242C13.4 8.20437 10.6935 8.38481 8.91284 10.1654L14.555 15.8076C16.3356 14.027 16.5161 11.3205 14.958 9.76242Z\" fill=\"#0075FF\"/>\n<path d=\"M15.4006 13.8949C15.2335 13.7272 15.0348 13.5941 14.8161 13.5033C14.5974 13.4125 14.3629 13.3657 14.1261 13.3657C13.8893 13.3657 13.6548 13.4125 13.4361 13.5033C13.2174 13.5941 13.0188 13.7272 12.8516 13.8949L11.9819 14.7646C11.0027 14.1432 10.0955 13.415 9.27693 12.5934C8.45711 11.7733 7.72909 10.8663 7.10574 9.88845L7.97542 9.01877C8.14316 8.85161 8.27626 8.65298 8.36707 8.43426C8.45789 8.21555 8.50464 7.98107 8.50464 7.74425C8.50464 7.50743 8.45789 7.27295 8.36707 7.05423C8.27626 6.83552 8.14316 6.63689 7.97542 6.46973L6.27805 4.77836C6.11325 4.61006 5.91629 4.47661 5.69889 4.38594C5.48149 4.29527 5.24808 4.24923 5.01253 4.25056C4.77531 4.24998 4.54031 4.29631 4.32106 4.38689C4.10181 4.47747 3.90264 4.61051 3.73501 4.77836L2.91931 5.58806C2.53052 6.00608 2.24035 6.50592 2.07013 7.05083C1.89991 7.59574 1.85397 8.17188 1.93568 8.73688C2.12761 10.986 3.60306 13.691 5.8762 15.9702C8.14935 18.2493 10.8843 19.7188 13.1335 19.9347C13.3013 19.9436 13.4695 19.9436 13.6373 19.9347C14.1214 19.955 14.6048 19.8785 15.059 19.7096C15.5132 19.5407 15.9291 19.2828 16.2823 18.951L17.092 18.1354C17.2598 17.9677 17.3929 17.7685 17.4835 17.5493C17.574 17.3301 17.6204 17.0951 17.6198 16.8578C17.6211 16.6223 17.5751 16.3889 17.4844 16.1715C17.3938 15.9541 17.2603 1